# Copy this file to .env and adjust as needed.
# Nothing here requires a paid service.

# --- Database ---
# Docker (PostgreSQL + PostGIS) — the default:
DATABASE_URL=postgresql+psycopg://agri:agri@localhost:5432/agri

# Fallback with zero setup (no Docker needed). Uncomment this and comment the
# line above. The app detects SQLite and skips the PostGIS geometry column.
# DATABASE_URL=sqlite:///./agri.db

# --- Services ---
# Where the backend finds the ML microservice
ML_SERVICE_URL=http://localhost:8001

# Where uploaded crop images are written on disk
STORAGE_PATH=./uploads

# Comma-separated origins allowed to call the API (the Vite dev server)
CORS_ORIGINS=http://localhost:5173

# --- Auth (not yet used in the MVP; see README "Known limitations") ---
JWT_SECRET=change-me-before-any-real-deployment
